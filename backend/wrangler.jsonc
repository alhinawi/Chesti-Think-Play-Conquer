{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chesti-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "vars": {
    // Comma separated. The site address(es) allowed to call the API from a browser.
    "ALLOWED_ORIGINS": "https://chesti.pages.dev,http://localhost:3000"
  },
  // Workers AI: free allocation only (10,000 Neurons/day per account, shared). No API key needed.
  "ai": { "binding": "AI" },
  // Usage counters for the learning helper: a small SQLite-backed Durable Object (free plan, additive).
  "durable_objects": { "bindings": [{ "name": "HELPER_LIMITER", "class_name": "HelperLimiter" }] },
  "migrations": [{ "tag": "helper-limiter-v1", "new_sqlite_classes": ["HelperLimiter"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chesti",
      // Placeholder: only used for local runs and tests. Replace with the real id
      // printed by `wrangler d1 create chesti` (see SETUP.ar.md). Not a secret.
      "database_id": "b8f921a9-62c5-4fec-909f-34765db75699",
      "migrations_dir": "migrations"
    }
  ]
}
